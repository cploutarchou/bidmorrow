<?xml version="1.0" encoding="UTF-8"?>
<!--
Representative fixture of the real ECB daily reference-rate feed shape
(https://www.ecb.europa.eu/stats/eurofxref/eurofxref-daily.xml), documented
publicly and stable for years: a gesmes:Envelope wrapping one dated Cube of
~30 currency Cube leaves. ecb.europa.eu is proxy-blocked from this dev
environment (same honesty pattern as TED — see IMPLEMENTATION_LEDGER.md);
this fixture is hand-built from the documented format, not a live capture,
and trimmed to a representative currency subset (all V1-relevant non-euro EU
member-state and EEA currencies are included).
-->
<gesmes:Envelope xmlns:gesmes="http://www.gesmes.org/xml/2002-08-01" xmlns="http://www.ecb.int/vocabulary/2002-08-01/eurofxref">
	<gesmes:subject>Reference rates</gesmes:subject>
	<gesmes:Sender>
		<gesmes:name>European Central Bank</gesmes:name>
	</gesmes:Sender>
	<Cube>
		<Cube time="2026-08-14">
			<Cube currency="USD" rate="1.0850"/>
			<Cube currency="JPY" rate="157.23"/>
			<Cube currency="BGN" rate="1.9558"/>
