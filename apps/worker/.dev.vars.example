# Local dev secrets/config for `wrangler dev` — NAMES ONLY, never real
# values (see /.env.example for the full application list). Copy this file
# to `.dev.vars` (git-ignored) and fill in local/test values.
#
# BETTER_AUTH_SECRET must be a locally generated value
# (`openssl rand -base64 32`) — never invent/commit a real secret
# (HUMAN_DECISION_BLOCKERS.md item 5). Staging/production secrets are set
# via `wrangler secret put <NAME> --env <env>`, never via this file.

APP_ENV=local
APP_BASE_URL=http://localhost:8787

BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:8787

# Comma-separated INTERNAL_ADMIN email allowlist (docs/security.md C6).
# Never real production emails in a committed file — this is names-only
# guidance; fill in your own local test address(es).
# See HUMAN_DECISION_BLOCKERS.md item 6 for the production allowlist.
ADMIN_EMAILS=

# Resend (digest email — Phase 8). Both optional in local/test: absent means
# the digest queue consumer falls back to a logging-only provider (no real
# send, never a startup failure). REQUIRED in staging/production
# (HUMAN_DECISION_BLOCKERS.md item 3 — Resend account is a human blocker).
RESEND_API_KEY=
EMAIL_FROM=

# Paddle Billing (ADR-0011). SANDBOX credentials only outside production,
# never mixed with live ones. All optional in local/test: absent means
# /api/billing/* and the webhook endpoint respond `not_configured` instead
# of constructing a client with an empty key. REQUIRED in staging/production
# (HUMAN_DECISION_BLOCKERS.md item 4 — the Paddle account/catalog is a human
# blocker; never invent a key or price id here). PADDLE_CLIENT_TOKEN is a
# PUBLIC Paddle.js token (test_…), PADDLE_API_KEY is the SECRET server key.
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_CLIENT_TOKEN=
PADDLE_ENVIRONMENT=sandbox
PADDLE_PRICE_FOUNDING_MONTHLY=
PADDLE_PRICE_STANDARD_MONTHLY=

# Phase 12 stage A: E2E test-only hooks (routes/test-hooks.ts). Double-gated
# with APP_ENV=local — set to exactly `true` ONLY in a local .dev.vars used
# for running the Playwright suite against `wrangler dev`. NEVER set for a
# normal local dev session you're using to browse the app manually (it
# activates the auth-email mailbox capture, replacing real/logged email
# delivery), and NEVER a staging/production var or secret.
E2E_TEST_HOOKS=
