{
  "name": "@bidmorrow/worker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply bidmorrow --local"
  },
  "dependencies": {
    "@bidmorrow/auth": "workspace:*",
    "@bidmorrow/billing": "workspace:*",
    "@bidmorrow/config": "workspace:*",
    "@bidmorrow/db": "workspace:*",
    "@bidmorrow/domain": "workspace:*",
    "@bidmorrow/matching": "workspace:*",
    "@bidmorrow/notifications": "workspace:*",
    "@bidmorrow/observability": "workspace:*",
    "@bidmorrow/procurement": "workspace:*",
    "@bidmorrow/ted": "workspace:*",
    "@hono/zod-validator": "^0.9.0",
    "hono": "^4.13.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.21.3",
    "@cloudflare/workers-types": "^5.20260814.1",
    "typescript": "~5.9.2",
    "vitest": "^4.1.0",
    "wrangler": "^4.123.0"
  }
}
