// BidMorrow Worker configuration.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bidmorrow",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  // nodejs_compat is required by Better Auth (AsyncLocalStorage) — ADR-0002.
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bidmorrow",
      // Local development and tests never talk to a remote database; wrangler
      // uses local storage in dev, so this ID is a placeholder until deploy.
      "database_id": "local-placeholder",
      "migrations_dir": "../../migrations",
    },
  ],
  // Native Workers rate-limit binding (docs/security.md C7) for `/api/org/*`
  // — in addition to Better Auth's own database-storage limiter on
  // `/api/auth/*`. 100 requests / 60s per client IP; middleware tolerates a
  // missing binding (see src/middleware/rate-limit.ts) — validate this
  // limit against real staging traffic before tightening it.
  "ratelimits": [
    {
      "name": "API_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 100, "period": 60 },
    },
  ],
  // Raw eForms XML snapshots (ADR-0005) — private, per-environment bucket.
  // `bidmorrow-snapshots*` buckets are created via the Cloudflare MCP
  // connector at first deploy of each environment (HUMAN_DECISION_BLOCKERS
  // item 1); local/test dev use miniflare's local R2 simulator, no real
  // bucket needed.
  "r2_buckets": [
    {
      "binding": "SNAPSHOTS",
      "bucket_name": "bidmorrow-snapshots-local",
    },
  ],
  // Ingestion run queue (ADR-0006): the daily cron enqueues one `ingest`
  // message; `queue()` in src/index.ts processes it. Bounded batch + bounded
  // retries + DLQ so a poison message can never wedge the queue.
  "queues": {
    "producers": [{ "queue": "bidmorrow-ingest-local", "binding": "INGEST_QUEUE" }],
    "consumers": [
      {
        "queue": "bidmorrow-ingest-local",
        "max_batch_size": 10,
        "max_retries": 3,
        "dead_letter_queue": "bidmorrow-ingest-dlq-local",
      },
    ],
  },
  // Cron triggers (UTC): daily ingestion catch-up, daily retention purge,
  // and a stale-ingestion watchdog (docs/architecture.md background paths).
  "triggers": {
    "crons": ["0 5 * * *", "30 6 * * *", "0 9 * * *"],
  },
  // Non-secret config vars. Secrets (BETTER_AUTH_SECRET) are NEVER put here:
  // local dev reads them from `.dev.vars` (git-ignored — see
  // .dev.vars.example), staging/production from `wrangler secret put
  // <NAME> --env <env>` (HUMAN_DECISION_BLOCKERS.md item 5).
  "vars": {
    "APP_ENV": "local",
    "APP_BASE_URL": "http://localhost:8787",
    "BETTER_AUTH_URL": "http://localhost:8787",
  },
  "env": {
    "staging": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "bidmorrow-staging",
          // set real IDs per HUMAN_DECISION_BLOCKERS.md item 1; never share databases across envs
          "database_id": "staging-placeholder",
          "migrations_dir": "../../migrations",
        },
      ],
      // SEC-P4-01: wrangler named environments do NOT inherit bindings from
      // the top level — this must be redeclared identically here and kept
      // in sync with the top-level `ratelimits` block above.
      "ratelimits": [
        {
          "name": "API_RATE_LIMITER",
          "namespace_id": "1001",
          "simple": { "limit": 100, "period": 60 },
        },
      ],
      // Distinct bucket/queue names per environment — never shared across envs.
      "r2_buckets": [
        {
          "binding": "SNAPSHOTS",
          "bucket_name": "bidmorrow-snapshots-staging",
        },
      ],
      "queues": {
        "producers": [{ "queue": "bidmorrow-ingest-staging", "binding": "INGEST_QUEUE" }],
        "consumers": [
          {
            "queue": "bidmorrow-ingest-staging",
            "max_batch_size": 10,
            "max_retries": 3,
            "dead_letter_queue": "bidmorrow-ingest-dlq-staging",
          },
        ],
      },
      "triggers": {
        "crons": ["0 5 * * *", "30 6 * * *", "0 9 * * *"],
      },
      "vars": {
        "APP_ENV": "staging",
        // set real URLs before first staging deploy
        "APP_BASE_URL": "https://staging.bidmorrow.com",
        "BETTER_AUTH_URL": "https://staging.bidmorrow.com",
      },
    },
    "production": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "bidmorrow-production",
          // set real IDs per HUMAN_DECISION_BLOCKERS.md item 1; never share databases across envs
          "database_id": "production-placeholder",
          "migrations_dir": "../../migrations",
        },
      ],
      // SEC-P4-01: wrangler named environments do NOT inherit bindings from
      // the top level — this must be redeclared identically here and kept
      // in sync with the top-level `ratelimits` block above.
      "ratelimits": [
        {
          "name": "API_RATE_LIMITER",
          "namespace_id": "1001",
          "simple": { "limit": 100, "period": 60 },
        },
      ],
      "r2_buckets": [
        {
          "binding": "SNAPSHOTS",
          "bucket_name": "bidmorrow-snapshots-production",
        },
      ],
      "queues": {
        "producers": [{ "queue": "bidmorrow-ingest-production", "binding": "INGEST_QUEUE" }],
        "consumers": [
          {
            "queue": "bidmorrow-ingest-production",
            "max_batch_size": 10,
            "max_retries": 3,
            "dead_letter_queue": "bidmorrow-ingest-dlq-production",
          },
        ],
      },
      "triggers": {
        "crons": ["0 5 * * *", "30 6 * * *", "0 9 * * *"],
      },
      "vars": {
        "APP_ENV": "production",
        "APP_BASE_URL": "https://bidmorrow.com",
        "BETTER_AUTH_URL": "https://bidmorrow.com",
      },
    },
  },
}
